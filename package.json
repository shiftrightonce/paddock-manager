{
  "name": "paddock-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Per-field agronomic logbook for a single farm operator (metric, Australia)",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -n api,ui -c green,cyan \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "node --watch server/index.js",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "seed": "node server/scripts/seed.js --force",
    "test": "node server/scripts/selftest.js",
    "smoke": "node server/scripts/apitest.js",
    "start:rust": "cargo run --release -- serve",
    "dev:api:rust": "cargo run -- serve",
    "build:rust": "cargo build --release",
    "serve:rust": "cargo run -- serve"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.1",
    "pdfkit": "^0.16.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}
